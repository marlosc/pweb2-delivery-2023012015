
<section class="card">
  <div style="
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  ">
    <div>
      <h2 style="margin: 0 0 8px;">
        Motoristas cadastrados
      </h2>

      <p style="margin: 0; color: #666;">
        Consulte os motoristas registrados no sistema.
      </p>
    </div>

    <a href="/motoristas/novo" class="btn">
      + Novo motorista
    </a>
  </div>

  <% if (!motoristas || motoristas.length === 0) { %>
    <p style="
      text-align: center;
      padding: 24px;
      color: #666;
    ">
      Nenhum motorista cadastrado.
    </p>
  <% } else { %>
    <div style="overflow-x: auto;">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>CPF</th>
            <th>Placa do veículo</th>
            <th>Status</th>
          </tr>
        </thead>

        <tbody>
          <% motoristas.forEach(function(motorista) { %>
            <tr>
              <td><%= motorista.id %></td>
              <td><%= motorista.nome %></td>
              <td><%= motorista.cpf %></td>

              <td>
                <%= motorista.placaVeiculo || 'Não informada' %>
              </td>

              <td>
                <strong>
                  <%= motorista.status %>
                </strong>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
